{
  "name": "@forge/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && npm run start",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "smoke:core": "npm run build && node scripts/smoke-core.mjs",
    "smoke:queue": "npm run build && node scripts/task-queue-fixtures.mjs",
    "smoke:observer": "npm run build && node scripts/observer-runtime-fixtures.mjs",
    "smoke:git-conflicts": "npm run build && node scripts/git-conflict-fixtures.mjs",
    "smoke:git-remote": "npm run build && node scripts/git-remote-fixtures.mjs",
    "smoke:inspection-guard": "npm run build && node scripts/inspection-guard-test.mjs",
    "smoke:provider-recovery": "npm run build && node scripts/provider-recovery-test.mjs",
    "smoke:repo-index": "npm run build && node scripts/repo-index-fixtures.mjs",
    "smoke:repo-index-pure": "npm run build && node scripts/repo-index-test.mjs",
    "smoke:symbol-extract": "npm run build && node scripts/symbol-extract-test.mjs",
    "smoke:symbol-search": "npm run build && node scripts/symbol-search-test.mjs",
    "smoke:text-search": "npm run build && node scripts/text-search-test.mjs",
    "smoke:github-remote": "npm run build && node scripts/github-remote-test.mjs",
    "smoke:pr-publish": "npm run build && node scripts/pr-publish-fixtures.mjs",
    "smoke:stuck-detection": "npm run build && node scripts/stuck-detection-test.mjs",
    "smoke:stuck-recovery": "npm run build && node scripts/stuck-recovery-fixtures.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
