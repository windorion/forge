{
  "name": "@forge/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "smoke:all": "node scripts/run-smoke-suite.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && npm run start",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:docs": "node ../script/check_documentation_truth.mjs",
    "database:restore": "npm run build && node scripts/database-restore.mjs",
    "test:unit": "npm run build && node --test scripts/*-test.mjs",
    "coverage:unit": "npm run build && node --test --experimental-test-coverage --test-coverage-include='dist/*.js' --test-coverage-include='dist/**/*.js' scripts/*-test.mjs",
    "smoke:core": "npm run build && node scripts/smoke-core.mjs",
    "smoke:queue": "npm run build && node scripts/task-queue-fixtures.mjs",
    "smoke:observer": "npm run build && node scripts/observer-runtime-fixtures.mjs",
    "smoke:mission-control": "npm run build && node scripts/mission-control-routing-fixtures.mjs",
    "smoke:mission-control-fairness": "npm run build && node scripts/mission-control-fairness-fixtures.mjs",
    "soak:mission-control": "../script/run_mission_control_soak.sh 21600",
    "smoke:http-contract": "npm run build && node scripts/runtime-http-contract-fixtures.mjs",
    "smoke:git-conflicts": "npm run build && node scripts/git-conflict-fixtures.mjs",
    "smoke:git-remote": "npm run build && node scripts/git-remote-fixtures.mjs",
    "smoke:inspection-guard": "npm run build && node scripts/inspection-guard-test.mjs",
    "smoke:provider-recovery": "npm run build && node scripts/provider-recovery-test.mjs",
    "smoke:repo-index": "npm run build && node scripts/repo-index-fixtures.mjs",
    "smoke:repo-index-pure": "npm run build && node scripts/repo-index-test.mjs",
    "smoke:symbol-extract": "npm run build && node scripts/symbol-extract-test.mjs",
    "smoke:symbol-search": "npm run build && node scripts/symbol-search-test.mjs",
    "smoke:text-search": "npm run build && node scripts/text-search-test.mjs",
    "smoke:github-remote": "npm run build && node scripts/github-remote-test.mjs",
    "smoke:pr-publish": "npm run build && node scripts/pr-publish-fixtures.mjs",
    "smoke:stuck-detection": "npm run build && node scripts/stuck-detection-test.mjs",
    "smoke:stuck-recovery": "npm run build && node scripts/stuck-recovery-fixtures.mjs",
    "smoke:task-cancel": "npm run build && node scripts/task-cancellation-fixtures.mjs",
    "smoke:task-retention": "npm run build && node scripts/task-history-retention-fixtures.mjs",
    "smoke:workspace-retention": "npm run build && node scripts/workspace-history-retention-fixtures.mjs",
    "smoke:approval-lifecycle": "npm run build && node scripts/approval-lifecycle-fixtures.mjs",
    "smoke:secret-redaction": "npm run build && node scripts/secret-redaction-fixtures.mjs",
    "smoke:database-recovery": "npm run build && node scripts/database-recovery-fixtures.mjs",
    "campaign:reliability": "npm run build && node scripts/reliability-campaign.mjs",
    "campaign:reliability:baseline": "npm run build && node scripts/reliability-campaign.mjs --write-baseline",
    "campaign:provider-reliability": "npm run build && node scripts/provider-reliability-campaign.mjs",
    "campaign:provider-reliability:baseline": "npm run build && node scripts/provider-reliability-campaign.mjs --write-baseline",
    "performance:smoke": "npm run build && node scripts/performance-campaign.mjs --profile smoke --enforce",
    "performance:standard": "npm run build && node scripts/performance-campaign.mjs --profile standard --enforce",
    "performance:large": "npm run build && node scripts/performance-campaign.mjs --profile large"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
